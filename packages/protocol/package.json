{
  "name": "@xolosarmy/tonalli-memo-protocol",
  "version": "0.2.0",
  "description": "Canonical wire protocol specification and implementation for Tonalli Memo (TM0/TM1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tm1-test-vectors.json": "./tm1-test-vectors.json"
  },
  "files": [
    "dist",
    "test-vectors.json",
    "tm1-test-vectors.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xolosArmy/tonalli-memo.git",
    "directory": "packages/protocol"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
