{
  "name": "@tonalli-memo/verification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tm1-authorization-vectors.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json --pretty false --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "vectors:generate": "node scripts/generate-authorization-vectors.mjs",
    "vectors:check": "node scripts/generate-authorization-vectors.mjs --check"
  },
  "dependencies": {
    "@tonalli-memo/chronik": "workspace:*",
    "@tonalli-memo/protocol": "workspace:*",
    "@tonalli-memo/registry": "workspace:*"
  },
  "devDependencies": {
    "ecash-lib": "4.13.0"
  }
}
